{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "CRG Scoreboard",
  "Version": "0.1.1.0",
  "Author": "Rose City Rollers",
  "URL": "https://github.com/rcrderby/crg-streamdeck-plugin",
  "Description": "Control the CRG Scoreboard with live game state on a Stream Deck.",
  "Category": "CRG Scoreboard",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": { "MinimumVersion": "7.4" },
  "OS": [
    { "Platform": "mac", "MinimumVersion": "12" },
    { "Platform": "windows", "MinimumVersion": "10" }
  ],
  "Nodejs": { "Version": "24" },
  "UUID": "com.rcrderby.crg-streamdeck",
  "Actions": [
    {
      "Name": "CRG Connection",
      "UUID": "com.rcrderby.crg-streamdeck.connection",
      "Icon": "imgs/actions/connection/icon",
      "PropertyInspectorPath": "ui/connection.html",
      "Tooltip": "CRG connection status. Press for options.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/connection/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "Active Clock",
      "UUID": "com.rcrderby.crg-streamdeck.active-clock",
      "Icon": "imgs/actions/active-clock/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Displays the clock and label that appear on the scoreboard. Informational only.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/active-clock/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "Score",
      "UUID": "com.rcrderby.crg-streamdeck.score",
      "Icon": "imgs/actions/score/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Shows a team's total score, total points in the current jam, and a jammer's current trip count, including the initial trip. Informational only.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/score/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "Jam Control",
      "UUID": "com.rcrderby.crg-streamdeck.jam-control",
      "Icon": "imgs/actions/jam-control/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Changes between 'Start Jam', 'Stop Jam', and 'End Timeout', based on the game state.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/jam-control/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "Timeout",
      "UUID": "com.rcrderby.crg-streamdeck.timeout",
      "Icon": "imgs/actions/timeout/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Starts an untyped timeout. Remains active until you select a team timeout, official review, or official timeout.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/timeout/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "Official Timeout",
      "UUID": "com.rcrderby.crg-streamdeck.official-timeout",
      "Icon": "imgs/actions/official-timeout/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Starts an official timeout.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/official-timeout/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "Lead",
      "UUID": "com.rcrderby.crg-streamdeck.lead",
      "Icon": "imgs/actions/lead/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Assigns or removes lead jammer status. Disabled during overtime and sudden scoring jams.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/lead/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "NI",
      "UUID": "com.rcrderby.crg-streamdeck.no-initial",
      "Icon": "imgs/actions/no-initial/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Assigns or removes 'No Initial' (trip) status for a jammer.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/no-initial/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "Star Pass",
      "UUID": "com.rcrderby.crg-streamdeck.star-pass",
      "Icon": "imgs/actions/star-pass/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Assigns or removes a star pass for a team. Disabled when 'No Pivot' is active.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/star-pass/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "Lost Lead",
      "UUID": "com.rcrderby.crg-streamdeck.lost-lead",
      "Icon": "imgs/actions/lost-lead/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Assigns or removes 'Lost Lead' status for a jammer. Requires a 1-second hold. Disabled during overtime and sudden scoring jams.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/lost-lead/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "Up 1",
      "UUID": "com.rcrderby.crg-streamdeck.trip-points-up",
      "Icon": "imgs/actions/trip-points-up/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Adds one point to the current scoring trip's total.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/trip-points-up/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "Down 1",
      "UUID": "com.rcrderby.crg-streamdeck.trip-points-down",
      "Icon": "imgs/actions/trip-points-down/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Removes one point from the current scoring trip's total.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/trip-points-down/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "Trip Points",
      "UUID": "com.rcrderby.crg-streamdeck.trip-score",
      "Icon": "imgs/actions/trip-points/icon",
      "PropertyInspectorPath": "ui/trip-points.html",
      "Tooltip": "Sets points for a jammer's current trip. Select the team and trip points, from 0 to 4.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/trip-points/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "Team Timeout",
      "UUID": "com.rcrderby.crg-streamdeck.team-timeout",
      "Icon": "imgs/actions/team-timeout/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Starts a team timeout or assigns an active timeout to a team. Displays total and remaining timeouts.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/team-timeout/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "Official Review",
      "UUID": "com.rcrderby.crg-streamdeck.official-review",
      "Icon": "imgs/actions/official-review/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Starts an official review or assigns an active timeout to a team. Displays the availability of a team's official review, and whether a team retained their review one or more times.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/official-review/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "Official Review Options",
      "UUID": "com.rcrderby.crg-streamdeck.official-review-options",
      "Icon": "imgs/actions/official-review-options/icon",
      "PropertyInspectorPath": "ui/review-options.html",
      "Tooltip": "Marks a team's official review as retained, or as taken as a team timeout. Choose 'Review Retained' or 'As a Team Timeout' in the button's settings. Available only while the team's official review is running. 'Review Retained' reads 'Review Won' when the team has no retains left in the period.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/official-review-options/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "Injury",
      "UUID": "com.rcrderby.crg-streamdeck.injury",
      "Icon": "imgs/actions/injury/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Assigns or removes 'Injury' status for both teams in a jam.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/injury/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "Add Trip",
      "UUID": "com.rcrderby.crg-streamdeck.add-trip",
      "Icon": "imgs/actions/add-trip/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Adds a new scoring trip for a team.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/add-trip/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "Remove Trip",
      "UUID": "com.rcrderby.crg-streamdeck.remove-trip",
      "Icon": "imgs/actions/remove-trip/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Removes a team's last scoring trip.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/remove-trip/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "No Pivot",
      "UUID": "com.rcrderby.crg-streamdeck.no-pivot",
      "Icon": "imgs/actions/no-pivot/icon",
      "PropertyInspectorPath": "ui/team.html",
      "Tooltip": "Assigns or removes 'No Pivot' status for a team. Disables the Star Pass button when enabled.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/no-pivot/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": true,
      "UserTitleEnabled": false
    },
    {
      "Name": "Undo",
      "UUID": "com.rcrderby.crg-streamdeck.undo",
      "Icon": "imgs/actions/undo/icon",
      "PropertyInspectorPath": "ui/undo.html",
      "Tooltip": "Undoes CRG's last clock action. Requires a 1-second hold.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/undo/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "Back",
      "UUID": "com.rcrderby.crg-streamdeck.back",
      "Icon": "imgs/actions/back/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Returns to your layout. Part of each page of buttons that the plugin opens. On the Timeout Before Period End page, returns to the End of Period page.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/back/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Connect or Disconnect",
      "UUID": "com.rcrderby.crg-streamdeck.connection-toggle",
      "Icon": "imgs/actions/connection-toggle/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Connects to or disconnects from CRG. Stays disconnected until you connect again, even after a restart. Requires a 1-second hold.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/connection-toggle/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Replacing",
      "UUID": "com.rcrderby.crg-streamdeck.replace-info",
      "Icon": "imgs/actions/replace-info/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Shows the clock action CRG is waiting to replace. Informational only.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/replace-info/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "No Action",
      "UUID": "com.rcrderby.crg-streamdeck.replace-confirm",
      "Icon": "imgs/actions/replace-confirm/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Confirms the undo with CRG's 'No Action', replacing it with nothing. Requires a 1-second hold.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/replace-confirm/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Replace Choice",
      "UUID": "com.rcrderby.crg-streamdeck.replace-choice",
      "Icon": "imgs/actions/replace-choice/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Replaces the undone action with one of the choices CRG allows. Requires a 1-second hold.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/replace-choice/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Automation",
      "UUID": "com.rcrderby.crg-streamdeck.automation",
      "Icon": "imgs/actions/automation/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Opens a page of CRG automation settings.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/automation/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "JRDA Options",
      "UUID": "com.rcrderby.crg-streamdeck.jrda-options",
      "Icon": "imgs/actions/jrda-options/icon",
      "PropertyInspectorPath": "ui/jrda-options.html",
      "Tooltip": "Shows or sets the JRDA-specific settings. Choose 'Continuation Upcoming' or 'Sudden Scoring' in the button's settings. 'Continuation Upcoming' shows the time a continued jam would run. Requires a 1-second hold to enable. 'Sudden Scoring' is activated automatically by the ruleset, so this button is informational only.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/jrda-options/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "End of Period",
      "UUID": "com.rcrderby.crg-streamdeck.end-of-period",
      "Icon": "imgs/actions/end-of-period/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Opens a page of end of period controls.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/end-of-period/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "Clocks",
      "UUID": "com.rcrderby.crg-streamdeck.clock",
      "Icon": "imgs/actions/clock/icon",
      "PropertyInspectorPath": "ui/clock.html",
      "Tooltip": "Displays the clock you select: 'Lineup', 'Period', 'Jam', 'Timeout', or 'Intermission'. Informational only. Add multiple buttons to display different clocks.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/clock/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "Auto End Jams",
      "UUID": "com.rcrderby.crg-streamdeck.auto-end-jams",
      "Icon": "imgs/actions/auto-end-jams/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Turns CRG's 'Auto End Jams' setting on or off. Part of the page that the Automation button opens. Changes the setting for every device connected to CRG.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/auto-end-jams/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Auto End Team Timeouts",
      "UUID": "com.rcrderby.crg-streamdeck.auto-end-team-timeouts",
      "Icon": "imgs/actions/auto-end-team-timeouts/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Turns CRG's 'Auto End Team Timeouts' setting on or off. Part of the page that the Automation button opens. Changes the setting for every device connected to CRG.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/auto-end-team-timeouts/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Official Score",
      "UUID": "com.rcrderby.crg-streamdeck.official-score",
      "Icon": "imgs/actions/official-score/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Makes the score official. Part of the page that the End of Period button opens. Requires a 1-second hold. Disabled if CRG delays the official score (EnforceTimeToOr). Displays an estimate of the remaining wait time.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/official-score/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Timeout Before Period End",
      "UUID": "com.rcrderby.crg-streamdeck.period-end-timeout",
      "Icon": "imgs/actions/period-end-timeout/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Opens a page to insert a timeout before the end of a period. Part of the page that the End of Period button opens. Sets the seconds remaining on the period clock.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/period-end-timeout/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Start Overtime Lineup",
      "UUID": "com.rcrderby.crg-streamdeck.overtime-lineup",
      "Icon": "imgs/actions/overtime-lineup/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Starts the overtime lineup clock. Part of the page that the End of Period button opens. Requires a 1-second hold. Disabled until CRG allows overtime.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/overtime-lineup/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Show Clock During Final Score",
      "UUID": "com.rcrderby.crg-streamdeck.clock-during-final-score",
      "Icon": "imgs/actions/clock-during-final-score/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Turns CRG's 'Show Clock During Final Score' setting on or off. Part of the page that the End of Period button opens.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/clock-during-final-score/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Seconds at Timeout",
      "UUID": "com.rcrderby.crg-streamdeck.period-end-seconds",
      "Icon": "imgs/actions/period-end-seconds/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Shows the time the period clock will be set to when the timeout starts. Part of the page that the Timeout Before Period End button opens. Informational only.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/period-end-seconds/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Minus 1 Second",
      "UUID": "com.rcrderby.crg-streamdeck.period-end-seconds-down",
      "Icon": "imgs/actions/period-end-seconds-down/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Removes 1 second from the time the period clock will be set to. Part of the page that the Timeout Before Period End button opens.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/period-end-seconds-down/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Plus 1 Second",
      "UUID": "com.rcrderby.crg-streamdeck.period-end-seconds-up",
      "Icon": "imgs/actions/period-end-seconds-up/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Adds 1 second to the time the period clock will be set to. Part of the page that the Timeout Before Period End button opens.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/period-end-seconds-up/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    },
    {
      "Name": "Start Timeout",
      "UUID": "com.rcrderby.crg-streamdeck.start-period-end-timeout",
      "Icon": "imgs/actions/start-period-end-timeout/icon",
      "PropertyInspectorPath": "ui/description.html",
      "Tooltip": "Starts an untyped timeout and sets the period clock to the chosen time. Part of the page that the Timeout Before Period End button opens. Requires a 1-second hold. Returns to your layout afterward.",
      "Controllers": ["Keypad"],
      "States": [{ "Image": "imgs/actions/start-period-end-timeout/key", "TitleAlignment": "middle" }],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false,
      "VisibleInActionsList": false
    }
  ],
  "Profiles": [
    {
      "Name": "profiles/connection-stream-deck",
      "DeviceType": 0,
