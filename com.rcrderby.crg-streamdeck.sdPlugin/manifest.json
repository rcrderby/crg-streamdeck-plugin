      "AutoInstall": false
    },
    {
      "Name": "profiles/connection-plus",
      "DeviceType": 7,
      "Readonly": true,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": false
    },
    {
      "Name": "profiles/connection-neo",
      "DeviceType": 9,
      "Readonly": true,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": false
    },
    {
      "Name": "profiles/connection-studio",
      "DeviceType": 10,
      "Readonly": true,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": false
    },
    {
      "Name": "profiles/connection-virtual",
      "DeviceType": 11,
      "Readonly": true,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": false
    },
    {
      "Name": "profiles/connection-plus-xl",
      "DeviceType": 13,
      "Readonly": true,
      "DontAutoSwitchWhenInstalled": true,
      "AutoInstall": false
    },
    {
      "Name": "profiles/undo-stream-deck",
