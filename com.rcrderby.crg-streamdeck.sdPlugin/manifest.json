{
  "$schema": "https://schemas.elgato.com/streamdeck/plugins/manifest.json",
  "Name": "CRG Scoreboard",
  "Version": "0.1.0.0",
  "Author": "Rose City Rollers",
  "URL": "https://github.com/rcrderby/crg-streamdeck-plugin",
  "Description": "Control the CRG Scoreboard and show live game state on a Stream Deck.",
  "Category": "CRG Scoreboard",
  "CategoryIcon": "imgs/plugin/category-icon",
  "Icon": "imgs/plugin/marketplace",
  "CodePath": "bin/plugin.js",
  "SDKVersion": 3,
  "Software": {
    "MinimumVersion": "7.1"
  },
  "OS": [
    {
      "Platform": "mac",
      "MinimumVersion": "12"
    },
    {
      "Platform": "windows",
      "MinimumVersion": "10"
    }
  ],
  "Nodejs": {
    "Version": "24",
    "Debug": "enabled"
  },
  "UUID": "com.rcrderby.crg-streamdeck",
  "Actions": [
    {
      "Name": "CRG Connection",
      "UUID": "com.rcrderby.crg-streamdeck.connection",
      "Icon": "imgs/actions/connection/icon",
      "PropertyInspectorPath": "ui/connection.html",
      "Tooltip": "Shows whether the plugin is connected to CRG. Press to reconnect.",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/connection/key",
          "TitleAlignment": "middle"
        }
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "Jam Control",
      "UUID": "com.rcrderby.crg-streamdeck.jam-control",
      "Icon": "imgs/actions/jam-control/icon",
      "Tooltip": "Starts or stops a jam, following the label CRG shows on its own control.",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/jam-control/key",
          "TitleAlignment": "middle"
        }
      ],
      "UserTitleEnabled": false
    },
    {
      "Name": "Clock",
      "UUID": "com.rcrderby.crg-streamdeck.clock",
      "Icon": "imgs/actions/clock/icon",
      "PropertyInspectorPath": "ui/clock.html",
      "Tooltip": "Displays a CRG clock.",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/clock/key",
          "TitleAlignment": "middle"
        }
      ],
      "SupportedInMultiActions": false,
      "UserTitleEnabled": false
    },
    {
      "Name": "Trip Score",
      "UUID": "com.rcrderby.crg-streamdeck.trip-score",
      "Icon": "imgs/actions/trip-score/icon",
      "PropertyInspectorPath": "ui/trip-score.html",
      "Tooltip": "Sets the trip score for a team, in that team's operator colors.",
      "Controllers": ["Keypad"],
      "States": [
        {
          "Image": "imgs/actions/trip-score/key",
          "TitleAlignment": "middle"
        }
      ],
      "UserTitleEnabled": false
    }
  ]
}
