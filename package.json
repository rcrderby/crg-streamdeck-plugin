{
  "name": "crg-streamdeck-plugin",
  "version": "0.2.0",
  "description": "Stream Deck plugin that controls and displays the CRG Scoreboard over its WebSocket",
  "license": "Apache-2.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "test": "node --test \"src/**/*.test.ts\"",
    "lint": "eslint --config .github/linters/eslint.config.mjs .",
    "format": "prettier --check .",
    "format:write": "prettier --write .",
    "validate": "streamdeck validate com.rcrderby.crg-streamdeck.sdPlugin",
    "pack": "streamdeck pack com.rcrderby.crg-streamdeck.sdPlugin --output dist --force",
    "probe": "node scripts/probe-crg.mjs",
    "install-plugin": "scripts/install-plugin.sh"
  },
  "dependencies": {
    "@elgato/streamdeck": "^2.1.2",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@elgato/cli": "^1.9.0",
    "@eslint/eslintrc": "^3.3.3",
    "@eslint/js": "^9.39.1",
    "@rollup/plugin-commonjs": "^29.0.2",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.1.0",
    "@tsconfig/node24": "^24.0.5",
    "@types/node": "^24.13.5",
    "@types/ws": "^8.18.1",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsonc": "^2.20.1",
    "globals": "^16.0.0",
    "prettier": "^3.7.4",
    "rollup": "^4.63.3",
    "tslib": "^2.6.2",
    "typescript": "^5.2.2"
  }
}
